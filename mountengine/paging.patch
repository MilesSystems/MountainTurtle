+func TestTurtleListingFailureDoesNotReportEOF(t *testing.T) {
+	ctx := context.Background()
+	base := t.TempDir()
+	_ = os.WriteFile(filepath.Join(base, "a"), []byte("data"), 0600)
+	f, _ := local.NewFs(ctx, "local", base, configmap.Simple{})
+	entries, _ := f.List(ctx, "")
+	gate := make(chan struct{})
+	failure := errors.New("listing failed")
+	f.Features().ListP = func(ctx context.Context, dir string, callback fs.ListRCallback) error {
+		if err := callback(entries); err != nil {
+			return err
+		}
+		<-gate
+		return failure
+	}
+	opt := vfscommon.Opt
+	v := New(ctx, f, &opt)
+	defer v.Shutdown()
+	d, _ := v.Root()
+	_, verifier, eof, err := d.ReadDirPage(ctx, 0, 0)
+	if err != nil || eof {
+		t.Fatal("early EOF", err)
+	}
+	close(gate)
+	_, _, eof, err = d.ReadDirPage(ctx, 2, verifier)
+	if !errors.Is(err, failure) || eof {
+		t.Fatal("listing error became successful EOF", err)
+	}
+}
