+package vfs
+
+import (
+	"context"
+	"errors"
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/config/configmap"
+	"github.com/rclone/rclone/vfs/vfscommon"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestTurtlePagedListing(t *testing.T) {
+	ctx := context.Background()
+	base := t.TempDir()
+	for _, name := range []string{"a.txt", "b.txt", "c.txt"} {
+		if err := os.WriteFile(filepath.Join(base, name), []byte(name), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f, err := local.NewFs(ctx, "local", base, configmap.Simple{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	entries, err := f.List(ctx, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	gate := make(chan struct{})
+	f.Features().ListP = func(ctx context.Context, dir string, callback fs.ListRCallback) error {
+		if err := callback(entries[:1]); err != nil {
+			return err
+		}
+		<-gate
+		return callback(entries[1:])
+	}
+	opt := vfscommon.Opt
+	opt.DirCacheTime = fs.Duration(time.Hour)
+	v := New(ctx, f, &opt)
+	defer v.Shutdown()
+	d, _ := v.Root()
+	page, verifier, eof, err := d.ReadDirPage(ctx, 0, 0)
+	if err != nil || eof || len(page) != 1 {
+		t.Fatalf("first page: %d %v %v", len(page), eof, err)
+	}
+	known := make(chan error, 1)
+	go func() {
+		n, e := v.Stat(page[0].Name())
+		if e == nil && n.Inode() != page[0].(Node).Inode() {
+			e = errors.New("inode changed")
+		}
+		known <- e
+	}()
+	select {
+	case err := <-known:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("known name waited for the rest of the directory")
+	}
+	// A missing Finder sidecar must not wait for the rest of the directory.
+	missing := make(chan error, 1)
+	go func() { _, err := v.Stat("._absent"); missing <- err }()
+	select {
+	case err := <-missing:
+		if err != ENOENT {
+			t.Fatalf("missing metadata: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("metadata probe waited for listing EOF")
+	}
+	// A second enumeration must not invalidate the active verifier.
+	_, same, _, err := d.ReadDirPage(ctx, 0, 0)
+	if err != nil || same != verifier {
+		t.Fatal("in-flight verifier changed")
+	}
+	waiting := make(chan struct{})
+	go func() { defer close(waiting); _, _, _, _ = d.ReadDirPage(ctx, 2, verifier) }()
+	select {
+	case <-waiting:
+		t.Fatal("returned false EOF before final page")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(gate)
+	select {
+	case <-waiting:
+	case <-time.After(time.Second):
+		t.Fatal("page did not resume")
+	}
+	all, err := d.ReadDirAll()
+	if err != nil || len(all) != 3 {
+		t.Fatalf("complete listing: %d %v", len(all), err)
+	}
+	page, _, eof, err = d.ReadDirPage(ctx, 2, verifier)
+	if err != nil || !eof || len(page) != 3 {
+		t.Fatalf("continuation: %d %v %v", len(page), eof, err)
+	}
+	_, newVerifier, _, err := d.ReadDirPage(ctx, 0, 0)
+	if err != nil || newVerifier == verifier {
+		t.Fatal("new snapshot missing")
+	}
+	if _, _, _, err = d.ReadDirPage(ctx, 2, verifier); err != nil {
+		t.Fatal("concurrent enumeration lost its snapshot", err)
+	}
+	if _, _, _, err = d.ReadDirPage(ctx, 2, 99999999); !errors.Is(err, ErrListingChanged) {
+		t.Fatal("invalid cookie accepted")
+	}
+	d.ForgetAll()
+	d.mu.Lock()
+	retained := d.listing != nil || len(d.listingHistory) > 0
+	d.mu.Unlock()
+	if retained {
+		t.Fatal("forgotten directory retained snapshots")
+	}
+
+}
