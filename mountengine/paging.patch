+	"os"
+)
+
+func (f *FS) ReadDirPage(ctx context.Context, p string, cookie, verifier uint64) ([]os.FileInfo, uint64, bool, error) {
+	node, err := f.vfs.Stat(f.fullPath(p))
+	if err != nil {
+		return nil, 0, false, err
+	}
+	dir, ok := node.(*vfs.Dir)
+	if !ok {
+		return nil, 0, false, os.ErrInvalid
+	}
+	entries, v, eof, err := dir.ReadDirPage(ctx, cookie, verifier)
+	if err == vfs.ErrListingChanged {
+		return nil, 0, false, &gonfs.NFSStatusError{gonfs.NFSStatusBadCookie, vfs.ErrListingChanged}
+	}
+	for _, e := range entries {
+		setSys(e)
+	}
+	return entries, v, eof, err
+}
