@@ -0,0 +1,211 @@
+package vfs
+
+import (
+	"context"
+	"errors"
+	"github.com/rclone/rclone/fs"
+	"github.com/rclone/rclone/fs/filter"
+	"github.com/rclone/rclone/fs/list"
+	"os"
+	"path"
+	"sort"
+	"sync/atomic"
+	"time"
+)
+
+var listingSequence atomic.Uint64
+var ErrListingChanged = errors.New("directory listing changed; restart enumeration")
+
+type directoryListing struct {
+	cancel   context.CancelFunc
+	verifier uint64
+	path     string
+	entries  []os.FileInfo
+	changed  chan struct{}
+	done     bool
+	err      error
+}
+
+// Caller holds d.mu; no remote operation runs while it is held.
+func (d *Dir) _startListing() *directoryListing {
+	if d.listing != nil && !d.listing.done {
+		return d.listing
+	}
+	_, stale := d._age(time.Now())
+	if !stale && d.listing != nil {
+		return d.listing
+	}
+	p := &directoryListing{verifier: listingSequence.Add(1), path: d.path, changed: make(chan struct{})}
+	if d.listing != nil {
+		d.listingHistory = append(d.listingHistory, d.listing)
+		if len(d.listingHistory) > 8 {
+			d.listingHistory = d.listingHistory[len(d.listingHistory)-8:]
+		}
+	}
+	d.listing = p
+	if !stale {
+		for _, n := range d.items {
+			p.entries = append(p.entries, n)
+		}
+		sort.Slice(p.entries, func(i, j int) bool { return p.entries[i].Name() < p.entries[j].Name() })
+		p.done = true
+		return p
+	}
+	mv := d._newManageVirtuals()
+	ctx, cancel := context.WithCancel(d.vfs.ctx)
+	p.cancel = cancel
+	go func() {
+		defer cancel()
+		seen := make(map[string]bool)
+		err := list.DirPages(ctx, d.f, p.path, func(entries fs.DirEntries) error {
+			d.mu.Lock()
+			defer d.mu.Unlock()
+			if d.path != p.path || d.listing != p {
+				return ErrListingChanged
+			}
+			if err := d._mergeListingEntries(entries, nil, time.Time{}, mv); err != nil {
+				return err
+			}
+			for _, e := range entries {
+				name := path.Base(e.Remote())
+				if n, ok := d.items[name]; ok && !seen[name] && d.virtual[name] != vDel {
+					p.entries = append(p.entries, n)
+					seen[name] = true
+				}
+			}
+			close(p.changed)
+			p.changed = make(chan struct{})
+			return nil
+		})
+		d.mu.Lock()
+		defer d.mu.Unlock()
+		if errors.Is(err, fs.ErrorDirNotFound) {
+			err = nil
+		}
+		if d.path != p.path || d.listing != p {
+			err = ErrListingChanged
+		}
+		if err == nil {
+			mv.end(d)
+			for name, n := range d.items {
+				if !seen[name] {
+					p.entries = append(p.entries, n)
+				}
+			}
+			d.read = time.Now()
+			d.cleanupTimer.Reset(time.Duration(d.vfs.Opt.DirCacheTime * 2))
+		}
+		p.err = err
+		p.done = true
+		close(p.changed)
+	}()
+	return p
+}
+
+// Caller keeps its lock on return, including on error. Full-directory operations still wait for real EOF.
+func (d *Dir) _waitForListing() error {
+	p := d._startListing()
+	for !p.done {
+		changed := p.changed
+		d.mu.Unlock()
+		<-changed
+		d.mu.Lock()
+	}
+	return p.err
+}
+
+// ReadDirPage returns a stable prefix. Cookies index this append-only snapshot;
+// EOF is never reported before the backend has completed successfully.
+func (d *Dir) ReadDirPage(ctx context.Context, cookie, verifier uint64) ([]os.FileInfo, uint64, bool, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.vfs.Opt.BlockNormDupes { // retain upstream normalization policy
+		if err := d._readDir(); err != nil {
+			return nil, 0, false, err
+		}
+	}
+	p := d.listing
+	if cookie == 0 {
+		if p != nil && p.done {
+			d.listingHistory = append(d.listingHistory, p)
+			if len(d.listingHistory) > 8 {
+				d.listingHistory = d.listingHistory[len(d.listingHistory)-8:]
+			}
+			d.listing = nil
+		}
+		p = d._startListing()
+	} else if p == nil || p.verifier != verifier {
+		p = nil
+		for _, old := range d.listingHistory {
+			if old.verifier == verifier {
+				p = old
+				break
+			}
+		}
+		if p == nil {
+			return nil, 0, false, ErrListingChanged
+		}
+	}
+	if cookie > 0 && verifier != p.verifier {
+		return nil, 0, false, ErrListingChanged
+	}
+	// The next real entry has index cookie-1 (cookies 0 and 1 are dot entries).
+	next := uint64(0)
+	if cookie > 1 {
+		next = cookie - 1
+	}
+	for uint64(len(p.entries)) <= next && !p.done {
+		changed := p.changed
+		d.mu.Unlock()
+		select {
+		case <-changed:
+		case <-ctx.Done():
+		}
+		d.mu.Lock()
+		if err := ctx.Err(); err != nil {
+			return nil, 0, false, err
+		}
+	}
+	if p.err != nil {
+		return nil, 0, false, p.err
+	}
+	return append([]os.FileInfo(nil), p.entries...), p.verifier, p.done, nil
+}
+
+// Finder probes these exact metadata filenames before displaying directory rows.
+// Their absence can be answered with one backend stat instead of waiting for EOF.
+// Called with d.mu held, and restores that lock on every return.
+func (d *Dir) _lookupFinderMetadata(leaf string) (Node, error, bool) {
+	if d.virtual[leaf] == vDel {
+		return nil, ENOENT, true
+	}
+	if len(filter.GetConfig(d.vfs.ctx).Opt.ExcludeFile) > 0 {
+		return nil, nil, false
+	}
+	directory := d.path
+	d.mu.Unlock()
+	object, err := d.f.NewObject(d.vfs.ctx, path.Join(directory, leaf))
+	included := err == nil && filter.GetConfig(d.vfs.ctx).IncludeObject(d.vfs.ctx, object)
+	d.mu.Lock()
+	if d.path != directory {
+		return nil, nil, false
+	}
+	if d.virtual[leaf] == vDel {
+		return nil, ENOENT, true
+	}
+	if n, ok := d.items[leaf]; ok {
+		return n, nil, true
+	}
+	if errors.Is(err, fs.ErrorObjectNotFound) || os.IsNotExist(err) {
+		return nil, ENOENT, true
+	}
+	if err != nil {
+		return nil, nil, false
+	}
+	if !included {
+		return nil, ENOENT, true
+	}
+	n := newFile(d, d.path, object, leaf)
+	d.items[leaf] = n
+	return n, nil, true
+}
