+	"github.com/rclone/rclone/fs/filter"
+)
+
+// DirPages preserves filtering and traversal checks. Sentinel-file filters require a complete list.
+func DirPages(ctx context.Context, f fs.Fs, dir string, callback fs.ListRCallback) error {
+	fi := filter.GetConfig(ctx)
+	if len(fi.Opt.ExcludeFile) > 0 {
+		entries, err := DirSorted(ctx, f, false, dir)
+		if err != nil {
+			return err
+		}
+		return callback(entries)
+	}
+	return listP(ctx, f, dir, func(entries fs.DirEntries) error {
+		accounting.Stats(ctx).Listed(int64(len(entries)))
+		entries, err := filterDir(ctx, entries, false, dir, fi.IncludeObject, fi.IncludeDirectory(ctx, f))
+		if err != nil {
+			return err
+		}
+		return callback(entries)
+	})
+}
