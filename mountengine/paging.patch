+package nfs
+
+import (
+	"context"
+	"os"
+)
+
+type pagedDirectory interface {
+	ReadDirPage(context.Context, string, uint64, uint64) ([]os.FileInfo, uint64, bool, error)
+}
+
+func getDirListingPage(ctx context.Context, h Handler, handle []byte, cookie, verifier uint64) ([]os.FileInfo, uint64, bool, error) {
+	f, p, err := h.FromHandle(handle)
+	if err != nil {
+		return nil, 0, false, &NFSStatusError{NFSStatusStale, err}
+	}
+	if pages, ok := f.(pagedDirectory); ok {
+		entries, v, eof, err := pages.ReadDirPage(ctx, f.Join(p...), cookie, verifier)
+		if err != nil {
+			if _, ok := err.(*NFSStatusError); ok {
+				return nil, 0, false, err
+			}
+			status := NFSStatusIO
+			if os.IsPermission(err) {
+				status = NFSStatusAccess
+			}
+			return nil, 0, false, &NFSStatusError{status, err}
+		}
+		return entries, v, eof, nil
+	}
+	entries, v, err := getDirListingWithVerifier(h, handle, verifier)
+	return entries, v, true, err
+}
