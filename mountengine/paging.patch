+package nfs
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"github.com/willscott/go-nfs-client/nfs/rpc"
+	"github.com/willscott/go-nfs-client/nfs/xdr"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestTurtleSlowRequestDoesNotBlockAnotherRPC(t *testing.T) {
+	gate := make(chan struct{})
+	const protocol = 999999
+	handler := func(ctx context.Context, w *response, h Handler) error {
+		value, err := xdr.ReadUint32(w.req.Body)
+		if err != nil {
+			return err
+		}
+		if value == 1 {
+			select {
+			case <-gate:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		}
+		return w.Write([]byte{0, 0, 0, 0})
+	}
+	if err := RegisterMessageHandler(protocol, 1, handler); err != nil {
+		t.Fatal(err)
+	}
+	defer delete(registeredHandlers, registeredHandlerID{protocol, 1})
+	server, client := net.Pipe()
+	defer client.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { (&Server{}).newConn(server).serve(ctx); close(done) }()
+	send := func(xid, value uint32) {
+		var payload bytes.Buffer
+		_ = xdr.Write(&payload, xid)
+		_ = xdr.Write(&payload, uint32(0))
+		_ = xdr.Write(&payload, rpc.Header{Rpcvers: 2, Prog: protocol, Vers: 3, Proc: 1})
+		_ = xdr.Write(&payload, value)
+		_ = binary.Write(client, binary.BigEndian, uint32(payload.Len())|1<<31)
+		if _, err := client.Write(payload.Bytes()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	send(1, 1)
+	send(2, 2)
+	_ = client.SetReadDeadline(time.Now().Add(time.Second))
+	var size uint32
+	if err := binary.Read(client, binary.BigEndian, &size); err != nil {
+		t.Fatal("slow request blocked fast request", err)
+	}
+	body := make([]byte, size&0x7fffffff)
+	if _, err := io.ReadFull(client, body); err != nil {
+		t.Fatal(err)
+	}
+	if got := binary.BigEndian.Uint32(body); got != 2 {
+		t.Fatalf("response xid=%d, want 2", got)
+	}
+	close(gate)
+	if err := binary.Read(client, binary.BigEndian, &size); err != nil {
+		t.Fatal(err)
+	}
+	body = make([]byte, size&0x7fffffff)
+	if _, err := io.ReadFull(client, body); err != nil {
+		t.Fatal(err)
+	}
+	if binary.BigEndian.Uint32(body) != 1 {
+		t.Fatal("wrong delayed response")
+	}
+	client.Close()
+	<-done
+}
