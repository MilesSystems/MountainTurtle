+package union
+
+import (
+	"context"
+	"errors"
+	"github.com/rclone/rclone/backend/local"
+	"github.com/rclone/rclone/backend/union/upstream"
+	"github.com/rclone/rclone/fs"
+	"strings"
+)
+
+func (f *Fs) ListP(ctx context.Context, dir string, callback fs.ListRCallback) error {
+	fallback := func() error {
+		entries, err := f.List(ctx, dir)
+		if err != nil {
+			return err
+		}
+		return callback(entries)
+	}
+	if len(f.upstreams) != 2 {
+		return fallback()
+	}
+	small, remote := f.upstreams[0], f.upstreams[1]
+	if _, ok := small.Fs.(*local.Fs); !ok || small.IsWritable() || remote.Features().ListP == nil {
+		return fallback()
+	}
+	entries, err := small.List(ctx, dir)
+	if err != nil && !errors.Is(err, fs.ErrorDirNotFound) {
+		return err
+	}
+	overlay := make(map[string]upstream.Entry)
+	key := func(s string) string {
+		if f.Features().CaseInsensitive {
+			return strings.ToLower(s)
+		}
+		return s
+	}
+	for _, e := range entries {
+		overlay[key(e.Remote())], _ = small.WrapEntry(e)
+	}
+	err = remote.Features().ListP(ctx, dir, func(page fs.DirEntries) error {
+		combined := make(fs.DirEntries, 0, len(page))
+		for _, e := range page {
+			r, _ := remote.WrapEntry(e)
+			candidates := []upstream.Entry{r}
+			if o, ok := overlay[key(e.Remote())]; ok {
+				candidates = []upstream.Entry{o, r}
+				delete(overlay, key(e.Remote()))
+			}
+			merged, err := f.wrapEntries(candidates...)
+			if err != nil {
+				return err
+			}
+			combined = append(combined, merged)
+		}
+		return callback(combined)
+	})
+	if err != nil && !errors.Is(err, fs.ErrorDirNotFound) {
+		return err
+	}
+	if errors.Is(err, fs.ErrorDirNotFound) && len(overlay) == 0 {
+		return err
+	}
+	remaining := make(fs.DirEntries, 0, len(overlay))
+	for _, e := range overlay {
+		merged, err := f.wrapEntries(e)
+		if err != nil {
+			return err
+		}
+		remaining = append(remaining, merged)
+	}
+	if len(remaining) > 0 {
+		return callback(remaining)
+	}
+	return nil
+}
